{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse — Customer Intelligence Agent for CSMs & AEs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx db/seed.ts",
